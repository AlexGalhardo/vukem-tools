root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4
tab_width = 4

# Formatos em que tab é proibido ou gerados por ferramentas.
[*.{yml,yaml}]
indent_style = space
indent_size = 2

[{package.json,bun.lock,*.toml}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

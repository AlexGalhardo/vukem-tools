# Copy to .env and fill it in. `go run ./cmd/app key:generate` writes APP_KEY.
# Every variable the app reads is listed here, including the ones whose feature
# is not wired yet, so nothing is configured by reading the source.

# ---------------------------------------------------------------- application
APP_NAME=Vukem Tools
APP_ENV=development
APP_KEY=
# Former APP_KEY values, comma-separated: they still decrypt after a rotation.
APP_PREVIOUS_KEYS=
APP_DEBUG=true
# Used in the links inside emails, so it must be the address users reach.
APP_URL=http://localhost:3000
HOST=localhost
PORT=3000
# A name for whichever deploy answered, stamped on every response as
# X-Deploy-Target. Any string a human recognises.
DEPLOY_TARGET=local

# ------------------------------------------------------------------- database
# PostgreSQL in every environment: the queue, sessions and cache live here, and
# SQLite would not survive the web and worker services being separate processes.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vukem_tools?sslmode=disable
# Used only by the schema tests, which create a throwaway database per test.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable

# -------------------------------------------------------- sessions and caching
SESSION_DRIVER=database
CACHE_STORE=database
RATE_LIMIT_STORE=cache

# ----------------------------------------------------------- queue and worker
QUEUE_CONNECTION=database
# false on the web service: the worker drains the queue (`app queue:work`).
QUEUE_IN_SERVE=true
QUEUE_CONCURRENCY=2
# true on the web service only, so the scheduler runs in exactly one process.
SCHEDULE_IN_SERVE=true

# --------------------------------------------------------------------- logging
LOG_FORMAT=text
LOG_LEVEL=info

# ------------------------------------------------------------ behind a proxy
# Railway's private range; without it the client IP is the proxy's and every
# rate limit shares one bucket.
TRUSTED_PROXIES=
CLIENT_IP_HEADER=
TRUST_FORWARDED_PROTO=false

# ------------------------------------------------------------------------ mail
# log writes the message to the log; mailtrap sends through the Mailtrap API.
MAIL_MAILER=log
MAIL_FROM=noreply@localhost
# With MAILTRAP_INBOX_ID the mail is captured in the sandbox inbox and nobody
# receives it. Without it, Mailtrap delivers for real, which needs a verified
# sending domain.
MAILTRAP_API_TOKEN=
MAILTRAP_INBOX_ID=

# -------------------------------------------------------------------- the API
# Comma-separated origins allowed to call /api/v1 from a browser.
CORS_ALLOWED_ORIGINS=

# ----------------------------------------------- object storage (phase S1.7)
# Where uploads and results live. Results expire 5 minutes after they are produced.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Required by most S3-compatible services that are not AWS.
S3_USE_PATH_STYLE=true

# ------------------------------------------------- malware scanning (S1.7)
# clamd address; uploads are rejected when it reports an infection.
CLAMAV_ADDR=

# --------------------------------------------- conversion engines (phase S1.11)
# Absolute paths, or leave empty to resolve from PATH. The app logs the
# resolved version of each one at startup.
# The names must match app/services/engines.go, which reads *_PATH. The
# *_BIN spellings this file used before were read by nothing.
FFMPEG_PATH=
FFPROBE_PATH=
YTDLP_PATH=
VIPS_PATH=
VIPSHEADER_PATH=
GHOSTSCRIPT_PATH=
PDFTOPPM_PATH=
PDFTOTEXT_PATH=
QPDF_PATH=

# ------------------------------------------------------- limits (phase S1.8)
MAX_UPLOAD_SIZE_MB=500
# Daily processing budget per account, in minutes; a conversion is refused
# once it is spent and the answer names when it resets (midnight UTC). Set it
# to 0 for no limit, which is right for a single-user instance.
#
# What is measured is wall-clock duration for a conversion that runs in this
# process, and real CPU time once a conversion is a subprocess, which is
# smaller: the budget only ever gets more generous as the measurement
# improves. See internal/quota.
QUOTA_CPU_MINUTES_PER_DAY=60
# Accounts the budget does not apply to, comma-separated user ids (normally
# just the owner's). They are still counted, so the figures stay true.
QUOTA_EXEMPT_USER_IDS=
# How long a result stays downloadable before the cleanup deletes it. Five minutes
# is the documented promise: the interface says it and the API reports expires_at.
RESULT_TTL_MINUTES=5

# ------------------------------------------------ downloads and edits (phase S3)
# The largest download allowed. Checked against the platform's estimate before
# yt-dlp starts, handed to yt-dlp as --max-filesize, and checked again on the
# finished file, because a platform that declares no size slips the first two.
MAX_DOWNLOAD_SIZE_MB=500
# The longest output a cut may produce, enforced before ffmpeg starts.
MAX_EDIT_DURATION_MINUTES=30

# A Netscape cookie jar for the platforms that want a signed-in session. Its
# absence degrades rather than fails: a jar expires, and most public videos
# download without one. An unreadable path is logged and ignored.
YOUTUBE_COOKIES_FILE=
# Base URL of a bgutil PO-token provider sidecar. Empty means none, which is
# normal; some YouTube clients then answer 403 and the error says the platform
# refused us. See docs/web-research.md section 4.3.
YTDLP_POT_PROVIDER_BASE_URL=
# Slow yt-dlp down so it looks less like a scraper. Seconds, fractions allowed.
# Empty means yt-dlp's default, which is no sleeping.
YTDLP_SLEEP_REQUESTS_SECONDS=
YTDLP_SLEEP_INTERVAL_SECONDS=
YTDLP_MAX_SLEEP_INTERVAL_SECONDS=
# How many times yt-dlp retries a request and a fragment.
YTDLP_RETRIES=3

# --------------------------------------------------------------- social login
# Google OAuth. The framework reads these names, not GOOGLE_CLIENT_ID:
# see https://vukem.dev/docs/security/social-login
# Authorised redirect URI in the Google console:
#   http://localhost:3000/auth/google/callback   (development)
#   https://tools.vukem.dev/auth/google/callback (production)
SOCIAL_GOOGLE_CLIENT_ID=
SOCIAL_GOOGLE_CLIENT_SECRET=

# ---------------------------------------------- the Telegram bot (phase S3.4)
# cmd/bot is its own binary and its own deploy. It is a client of this API
# with a key that carries one ability, so it needs no database, no bucket and
# no engines.
#
# The bot's token from BotFather.
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user ids allowed to use the bot. Required: cmd/bot
# refuses to start without it, because a download bot with no allow-list is a
# download bot for the internet. 0 is not a valid id — an update with no
# sender would compare as 0.
TELEGRAM_ALLOWED_USERS=
# Where the bot reaches this API, and a key carrying only video:download.
BOT_API_URL=
BOT_API_KEY=
# Overrides the Bot API root, for a test or a local stub. Empty uses
# https://api.telegram.org.
TELEGRAM_API_URL=

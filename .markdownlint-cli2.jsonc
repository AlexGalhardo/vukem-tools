{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/main/schema/markdownlint-cli2-config-schema.json",
  "config": {
    "default": true,
    // Headings and lists
    "MD003": { "style": "atx" },
    "MD004": { "style": "dash" },
    "MD007": { "indent": 2 },
    // Go and Makefile fences contain hard tabs (.editorconfig)
    "MD010": { "code_blocks": false, "ignore_code_languages": ["go", "makefile", "make"] },
    // Long lines are fine in prose and tables
    "MD013": false,
    // Keep a Changelog repeats "### Added" under each release
    "MD024": { "siblings_only": true },
    "MD033": { "allowed_elements": ["details", "summary", "br", "img", "picture", "source", "a", "p", "h1", "kbd", "sup"] },
    // GitHub templates start with "##"
    "MD041": false,
    "MD046": { "style": "fenced" },
    // Table column alignment is not enforced
    "MD060": false
  },
  "globs": ["**/*.md"],
  // Vendored agent material, not our prose
  "ignores": ["**/node_modules/**", "**/testdata/**", ".claude/skills/**", ".claude/agents/**", ".claude/references/**"]
}

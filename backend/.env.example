# Copie para backend/.env. Todas as variáveis têm default em app/config.py.
# Segredos (API_KEY, cookies, proxy) NUNCA vão para o git.

# --- Segurança ---
# Obrigatório quando o backend é acessível pela internet (ex.: atrás do Caddy na VPS).
# Gere com: openssl rand -hex 32. O frontend e o bot enviam o mesmo valor em X-API-Key.
API_KEY=
ALLOWED_ORIGINS=http://localhost:3000
DOCS_ENABLED=true
DEBUG=false
# Rótulo do deploy devolvido em X-Deploy-Target e no /health (ex.: "VPS Hostinger", "Koyeb").
# Vazio = autodetecta ("Koyeb (<região>)" quando há variáveis KOYEB_*, senão "local").
DEPLOY_TARGET=

# --- Limites ---
MAX_FILE_SIZE_MB=1024
MAX_UPLOAD_SIZE_MB=1024
MAX_CONCURRENT_JOBS=3
# 1 reduz o pico de RAM do ffmpeg em servidores pequenos (0 = automático).
FFMPEG_THREADS=0

# --- YouTube (ver docs/youtube.md) ---
# Proxy usado SÓ para o YouTube. Com o túnel SSH para a internet de casa:
#   YOUTUBE_PROXY=socks5h://127.0.0.1:1080
YOUTUBE_PROXY=
YTDLP_POT_PROVIDER_ENABLED=true
YTDLP_POT_PROVIDER_URL=http://127.0.0.1:4416
YTDLP_JS_RUNTIME=node
YTDLP_FORCE_IPV4=true
# Vazio = clients padrão do yt-dlp (recomendado).
YTDLP_PLAYER_CLIENTS=

# --- Cookies (formato Netscape) ---
# Arquivo: <PLATAFORMA>_COOKIES_FILE=cookies/instagram_cookies.txt
# Inline:  <PLATAFORMA>_COOKIES=<conteúdo ou base64 com COOKIES_FROM_BASE64=true>
# Instagram quase sempre exige; YouTube só é tentado com cookies se cair no bot-check.
INSTAGRAM_COOKIES_FILE=
INSTAGRAM_COOKIES=
YOUTUBE_COOKIES_FILE=
YOUTUBE_COOKIES=
TWITTER_COOKIES_FILE=
TWITTER_COOKIES=
TIKTOK_COOKIES_FILE=
TIKTOK_COOKIES=
COOKIES_FROM_BASE64=false

    "test:site": "node --test scripts/link-anchors.test.ts scripts/markdown-twin.test.ts scripts/generate-reference.test.ts scripts/api-reference.test.ts scripts/mcp-reference.test.ts scripts/check-doc-claims.test.ts scripts/accessibility-page.test.ts scripts/latest-release.test.ts scripts/glossary.test.ts scripts/shortcuts-reference.test.ts scripts/base-path.test.ts scripts/check-built.test.ts"
  },
  "dependencies": {

---
import Base from "../layouts/Base.astro";
import { Sidebar } from "@/components/sidebar";
import { getNavGroups, type Doc } from "@/lib/content";
import { docMetadata } from "@/components/doc-article";
import { ui } from "@/lib/ui-text";
import { renderDoc } from "../prerender";

interface Props {
	doc: Doc;
}

const { doc } = Astro.props;
const meta = docMetadata(doc);
const html = await renderDoc(doc);
const groups = getNavGroups(doc.section);
---

<Base title={meta.title} description={meta.description} canonical={doc.href} twin={`${doc.href}.md`} section={doc.section} progress>
	<div class="mx-auto flex max-w-[90rem] px-4 sm:px-6">
		<aside
			aria-label={ui.documentation}
			class="sticky top-(--header-h) hidden h-[calc(100dvh-var(--header-h))] w-64 shrink-0 overflow-y-auto py-8 pr-6 scroll-slim lg:block"
		>
			<Sidebar client:load groups={groups} pathname={doc.href} />
		</aside>
		<div class="min-w-0 flex-1">
			<Fragment set:html={html} />
		</div>
	</div>
</Base>

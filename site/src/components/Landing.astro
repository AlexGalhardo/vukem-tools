---
import { landing as copy } from "@/lib/landing";
import { dockerRunCommand } from "@/lib/latest-release";
import { withBase } from "@/lib/site";

const command = dockerRunCommand();
const lines = command.split("\n");
---

<main
	id="content"
	data-landing
	class="mx-auto w-full max-w-[90rem] fit:h-[calc(100dvh-var(--header-h))] fit:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] fit:overflow-hidden grid grid-cols-1"
>
	<section aria-labelledby="hero" class="relative flex min-w-0 flex-col px-4 py-8 sm:px-6 fit:py-6">
		<div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top_left,var(--accent-soft),transparent_70%)]"></div>

		<div class="my-auto">
			<h1 id="hero" class="text-3xl font-semibold tracking-tight text-fg">{copy.hero.title}</h1>
			<p class="mt-2 max-w-xl text-sm leading-snug text-muted">{copy.hero.lead}</p>

			<div class="mt-4 max-w-xl">
				<p id="run-label" class="text-xs text-muted">{copy.hero.runLabel}</p>
				<div role="group" aria-labelledby="run-label" class="mt-2 overflow-hidden rounded-xl border border-border-strong bg-code-bg">
					<div class="flex items-center justify-between border-b border-border px-3 py-1.5">
						<span aria-hidden="true" class="flex gap-1.5"><i class="size-2.5 rounded-full bg-border-strong"></i><i class="size-2.5 rounded-full bg-border-strong"></i><i class="size-2.5 rounded-full bg-border-strong"></i></span>
						<button
							type="button"
							data-copy={command}
							aria-label="Copy the docker run command"
							class="rounded-md border border-border px-2 py-0.5 text-xs font-medium text-muted hover:bg-hover hover:text-fg"
						>
							Copy
						</button>
					</div>
					<pre
						tabindex="0"
						class="overflow-x-auto px-3 py-2.5 font-mono text-[0.7rem] leading-relaxed text-fg"
					><code>{lines.map((line, i) => (<span class="block whitespace-pre">{i === 0 ? <span aria-hidden="true" class="select-none text-faint">$ </span> : <span aria-hidden="true" class="select-none">{"  "}</span>}{line.replace(/^ {2}/, "")}</span>))}</code></pre>
				</div>
				<p class="mt-2 text-xs leading-relaxed text-faint">{copy.hero.runNote}</p>
			</div>

			<ul class="mt-4 grid max-w-xl gap-x-4 gap-y-1 text-xs text-muted [@media(max-height:760px)]:hidden sm:grid-cols-2">
				{copy.hero.points.map((point) => (
					<li class="flex gap-2">
						<svg aria-hidden="true" viewBox="0 0 16 16" class="mt-0.5 size-4 shrink-0 text-accent" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 8.5 3.2 3L13 4.5"></path></svg>
						<span>{point}</span>
					</li>
				))}
			</ul>

			<div class="mt-4 flex flex-wrap items-center gap-3">
				<a href={withBase("/docs/quick-start/")} class="inline-flex h-10 items-center rounded-lg bg-[#6446f0] px-4 text-sm font-semibold text-white hover:bg-[#5a3be6]">{copy.hero.quickStart} &rarr;</a>
				<a href={withBase("/changelog/")} class="inline-flex h-10 items-center rounded-lg border border-border-strong px-4 text-sm font-semibold text-fg hover:bg-hover">{copy.hero.releases}</a>
			</div>
		</div>
	</section>

	<section aria-labelledby="gallery" class="flex min-w-0 flex-col justify-center border-t border-border bg-subtle px-5 py-6 sm:px-8 fit:border-t-0 fit:border-l fit:px-8">
		<h2 id="gallery" class="sr-only">{copy.gallery.label}</h2>
		<div data-tabs class="mx-auto w-full max-w-3xl">
			<div role="tablist" aria-label={copy.gallery.label} class="flex flex-wrap gap-1.5">
				{copy.features.map((f, i) => (
					<button
						type="button"
						role="tab"
						id={`tab-${f.id}`}
						data-tab={f.id}
						aria-controls={`panel-${f.id}`}
						aria-selected={i === 0 ? "true" : "false"}
						class="rounded-full border border-border-strong px-3 py-1 text-xs font-medium text-muted hover:bg-hover hover:text-fg aria-selected:border-accent aria-selected:bg-accent-soft aria-selected:text-accent"
					>
						{f.tab}
					</button>
				))}
			</div>

			{copy.features.map((f, i) => (
				<div role="tabpanel" id={`panel-${f.id}`} data-panel={f.id} aria-labelledby={`tab-${f.id}`} hidden={i !== 0} class="mt-3">
					<figure class="m-0">
						{f.image && (
							<img
								src={withBase(f.image.src)}
								alt={f.image.alt}
								width="1440"
								height="900"
								loading={i === 0 ? "eager" : "lazy"}
								decoding="async"
								class="aspect-[8/5] max-h-[calc(100dvh-var(--header-h)-15rem)] w-full rounded-xl border border-border-strong bg-black object-contain shadow-2xl shadow-black/20"
							/>
						)}
						<figcaption class="mt-3">
							<h3 class="text-base font-semibold text-fg">{f.title}</h3>
							<p class="mt-1 text-sm leading-relaxed text-muted">{f.text}</p>
							<p class="mt-2 text-xs text-faint">In Vukem Tools: <code class="rounded bg-code-bg px-1.5 py-0.5 font-mono text-fg">{f.command}</code></p>
						</figcaption>
					</figure>
				</div>
			))}
		</div>
	</section>
</main>

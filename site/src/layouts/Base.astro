---
import "../styles/global.css";

interface Props {
	title: string;
	summary?: string;
}

const { title, summary } = Astro.props;
const full = title === "Vukem Tools" ? title : `${title} · Vukem Tools`;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{full}</title>
		{summary && <meta name="description" content={summary} />}
		<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
	</head>
	<body class="bg-paper text-ink font-sans antialiased">
		<header class="border-b border-ink/10">
			<nav class="mx-auto flex max-w-3xl items-center gap-6 px-6 py-4 text-sm">
				<a href="/" class="font-semibold text-signal">Vukem Tools</a>
				<a href="/docs/">Docs</a>
				<a href="/docs/mcp/">MCP</a>
				<a href="/docs/api/">API</a>
			</nav>
		</header>
		<main class="mx-auto max-w-3xl px-6 py-12">
			<slot />
		</main>
	</body>
</html>

---
import Base from "../layouts/Base.astro";
---

<Base title="Vukem Tools" summary="Convert a file in the browser, in a desktop window, or from an agent.">
	<p class="text-sm font-medium tracking-wide text-signal uppercase">File conversion</p>
	<h1 class="mt-3 text-4xl font-semibold tracking-tight">One catalogue. Browser, window, and agent.</h1>
	<p class="mt-4 text-lg leading-relaxed">
		Vukem Tools converts files. The desktop window is the web app. An agent uses the same tool names from the
		command line, HTTP, or MCP.
	</p>
	<p class="mt-8 flex gap-4 text-sm">
		<a class="rounded-md bg-signal px-4 py-2 text-paper" href="/docs/quick-start/">Crop a PDF</a>
		<a class="rounded-md border border-ink/20 px-4 py-2" href="/docs/">Read the docs</a>
	</p>
</Base>

# Token do @BotFather (/newbot). Segredo: nunca versione o .env real.
TELEGRAM_BOT_TOKEN=

# IDs numéricos autorizados, separados por vírgula (@userinfobot mostra o seu).
# Vazio = ninguém usa o bot (fail-closed).
ALLOWED_TELEGRAM_USER_IDS=

# Backend: http://127.0.0.1:8000 no PM2 (mesmo host) ou http://backend:8000 no Docker Compose.
API_BASE_URL=http://127.0.0.1:8000
# Mesmo valor de API_KEY do backend (deixe vazio se o backend não exigir chave).
API_KEY=

# URL pública do frontend: monta o link de arquivos maiores que o limite do Telegram (50 MB).
PUBLIC_WEB_BASE_URL=https://video.galhardo.tech

# Opcionais (defaults em app/config.py)
# REQUEST_TIMEOUT_SECONDS=120
# MIN_CLIPS_DURATION_SECONDS=60
